<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="kvm">
  <name>{{uuid}}</name>
  <description>{{description}}</description>
  <uuid>{{uuid}}</uuid>
  <memory unit="KiB">{{mem_kib}}</memory>
  <vcpu placement="static">{{vcpu}}</vcpu>
  <cpu>
    <topology sockets="1" cores="{{vcpu}}" threads="1"/>
  </cpu>
  <os>
    <type xmlns:scaled="http://www.scalecomputing.com/scaled" arch="x86_64" machine="pc-q35-rhel9.2.0">hvm</type>
    <loader xmlns:scaled="http://www.scalecomputing.com/scaled" readonly="yes" secure="yes" type="pflash">/usr/share/OVMF/OVMF_CODE.secboot.fd</loader>
    <nvram>scribe:scribe/{{nvram_uuid}}</nvram>
    <smbios mode="sysinfo"/>
  </os>
  <sysinfo type="smbios">
    <entry name="system"/>
    <entry name="baseBoard"/>
  </sysinfo>
  <metadata>
    <scale-metadata xmlns="http://www.scalecomputing.com/scaled">
      <os uuid="{{os}}"/>
      <tags>
{{tags}}      </tags>
      <cpuVendor name="intel"/>
      <cpu name="{{cpu_type}}"/>
      <machine name="scale-uefi-9.5" version="9.6"/>
      <aes present="true"/>
    </scale-metadata>
  </metadata>
  <features>
    <acpi/>
    <apic/>
    <pae/>
    <msrs unknown="ignore"/>
    <smm state="on"/>
  </features>
  <clock offset="utc">
    <timer name="pit" tickpolicy="delay"/>
    <timer name="rtc" tickpolicy="catchup"/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <input type="tablet" bus="usb"/>
    <controller type="virtio-serial" index="0">
      <address type="pci" domain="0x0000" bus="0x00" slot="0x02" function="0x0"/>
    </controller>
    <channel type="unix">
      <source mode="bind" path="/var/lib/libvirt/qemu/{{uuid}}.agent"/>
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>
    <memballoon model="none"/>
    <controller type="usb" index="0" model="qemu-xhci">
      <address type="pci" domain="0x0000" bus="0x00" slot="03"/>
    </controller>
    <controller type="pci" index="0" model="pcie-root"/>
    <controller type="pci" model="pcie-root-port">
      <address type="pci" domain="0x0000" bus="0x00" slot="0x04" function="0x0" multifunction="on"/>
    </controller>
    <controller type="pci" model="pcie-root-port">
