# =============================================================================
# HyperCore Manager - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Docker Compose project name (keeps all containers on the same network) ---
COMPOSE_PROJECT_NAME=drsproject

# --- Clusters ---
# HyperCore clusters are registered in the dashboard (Settings -> Clusters), not here.
# Their credentials are stored encrypted in PostgreSQL with this key. Generate one with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Back it up together with the database: without it the stored passwords are unrecoverable.
HCM_SECRET_KEY=CHANGE_ME

# Timezone for scheduled jobs and log timestamps (IANA name, e.g. Europe/Amsterdam)
TZ=UTC

# --- InfluxDB ---
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=hypercore
INFLUX_BUCKET=metrics

# Retention & Downsampling
INFLUX_PRIMARY_RETENTION=365
INFLUX_LONGTERM_BUCKET=metrics_longterm
INFLUX_LONGTERM_RETENTION=1825
# InfluxDB's own memory caps, kept below the container limit (768 MB in docker-compose.yaml) so a
# heavy query is refused with an error instead of Docker killing the database. Raise together
# with the limit on big installations.
INFLUXD_QUERY_MAX_MEMORY_BYTES=402653184
INFLUXD_QUERY_MEMORY_BYTES=268435456
INFLUXD_QUERY_INITIAL_MEMORY_BYTES=16777216
INFLUXD_QUERY_CONCURRENCY=16
INFLUXD_STORAGE_CACHE_MAX_MEMORY_SIZE=201326592

# --- Balancer, collector and dashboard tunables ---
# Not set here. Dry-run, thresholds, cooldowns, the Oracle, poll intervals and the stale
# threshold ship with defaults and are edited per cluster in the dashboard under
# Settings -> Tunables (the Defaults template applies to clusters registered later).

# --- Auto-update ---
# Absolute path to the cloned repo on the host.
# The dashboard mounts this as /repo and uses it to run git pull + docker-compose.
# Required for the auto-update button to work.
SC_REPO_PATH=/opt/hypercore-manager
# Absolute path to the SSH key directory used to authenticate with the git remote.
# Mounted read-only inside the dashboard container. Your existing key works as-is.
SC_SSH_KEY_PATH=/root/.ssh

# --- Dashboard ---
# Initial admin credentials — used ONLY to seed the first user row on a fresh deployment.
# After that, manage users from the Settings → Users panel inside the dashboard.
# Leave SC_DASHBOARD_USER blank to disable authentication entirely (dev/local mode).
SC_DASHBOARD_USER=admin
SC_DASHBOARD_PASSWORD=CHANGE_ME

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank a random key is generated at startup (sessions won't survive restarts).
SC_DASHBOARD_SECRET_KEY=CHANGE_ME
# OTP is now configured per-user inside the dashboard Settings → My Account panel.

# =============================================================================
# Foresight — Sentinel (starts with the stack; `docker compose stop sentinel` to run without it)
# =============================================================================

# --- PostgreSQL ---
SENTINEL_PG_PASSWORD=CHANGE_ME

# --- Forecast toggles ---
SENTINEL_FORECAST_30D_ENABLED=true
SENTINEL_FORECAST_90D_ENABLED=true
# Phase 2: strategic horizons (B3, B4)
SENTINEL_FORECAST_180D_ENABLED=true
SENTINEL_FORECAST_365D_ENABLED=true

# --- Anomaly filtering (B9) ---
# Remove IQR outliers from metric series before regression
SENTINEL_ANOMALY_FILTER_ENABLED=true

# --- Forecast statistical gate ---
# Minimum r² required before a positive slope produces an exhaustion date.
# Suppresses spurious exhaustion alerts driven by noise on near-flat series.
# 0.5 = linear model must explain at least 50% of variance.  0.0 disables.
SENTINEL_FORECAST_MIN_R2_FOR_EXHAUSTION=0.5

# --- Cluster forecast daily aggregation ---
# How sub-day samples roll up into the daily data point used by cluster
# CPU / RAM / storage forecasts.  Allowed values: mean | p95 | max
#   mean = time-weighted average; suits steady workloads (default).
#   p95  = 95th percentile; captures sustained peak in spiky / VDI
#          environments without being skewed by transient spikes.
#   max  = single highest sample of the day; worst-case visibility.
SENTINEL_FORECAST_DAILY_AGGREGATE=mean

# --- Right-sizing thresholds ---
# C1: flag VMs using less than this % of allocated CPU consistently
SENTINEL_CPU_OVER_PROVISIONED_THRESHOLD=20.0
# C2: flag VMs averaging above this % CPU (sustained under-provisioning)
SENTINEL_CPU_UNDER_PROVISIONED_AVG_THRESHOLD=80.0
# C2: flag VMs hitting above this % CPU at P95 (burst-pattern under-provisioning)
SENTINEL_CPU_UNDER_PROVISIONED_P95_THRESHOLD=90.0

# --- Analysis window ---
# Number of days of history used for right-sizing analysis (captures 2 weekday+weekend cycles)
SENTINEL_ANALYSIS_WINDOW_DAYS=14
# Minimum spike recurrences before flagging as a pattern (C2 Signal 3)
SENTINEL_RECURRING_SPIKE_MIN_OCCURRENCES=3

# --- Data retention ---
SENTINEL_RETENTION_MONTHS=12

# --- Collection intervals ---
# How often Sentinel pulls real-time metrics from InfluxDB (seconds)
SENTINEL_COLLECTION_INTERVAL_SECONDS=300
# How often Sentinel runs trend/forecast analysis (seconds)
SENTINEL_TREND_INTERVAL_SECONDS=3600
# How often Sentinel removes records for VMs no longer active in InfluxDB (seconds)
# Active window used for the check is always 2x this value, so brief collector
# hiccups never trigger a false purge. Also live-tunable via the dashboard.
SENTINEL_VM_PRUNE_INTERVAL_SECONDS=900

# --- REST API (F1-F4, F6) ---
# Bearer token required to call the Sentinel REST API on port 8081.
# Leave empty to disable auth (dev/internal use only).
SENTINEL_API_TOKEN=CHANGE_ME

# =============================================================================
# Foresight — Phase 3 settings
# =============================================================================

# --- C7: Right-sizing outcome tracking ---
# Sentinel uses the cluster credentials from the registry (Settings -> Clusters)
# to detect VM spec changes after a recommendation.
# Enable/disable outcome tracking entirely:
SENTINEL_OUTCOME_TRACKER_ENABLED=true
# Hours to wait after a recommendation before checking the outcome (default 48h):
SENTINEL_OUTCOME_CHECK_DELAY_HOURS=48
# How often the outcome tracker runs (seconds, default 6 hours):
SENTINEL_OUTCOME_CHECK_INTERVAL_SECONDS=21600

# --- F5: Webhook/alert push notifications ---
# Target URL for outbound webhook POST requests.
# Leave empty to disable webhooks entirely.
SENTINEL_WEBHOOK_URL=
# HMAC-SHA256 signing secret. Recipients use this to verify request authenticity.
# Leave empty to send unsigned requests (not recommended for production).
SENTINEL_WEBHOOK_SECRET=CHANGE_ME
# Master enable/disable switch (still requires SENTINEL_WEBHOOK_URL to be set):
SENTINEL_WEBHOOK_ENABLED=true
# HTTP timeout per delivery attempt (seconds):
SENTINEL_WEBHOOK_TIMEOUT_SECONDS=10
# Maximum delivery attempts before marking as dead_letter:
SENTINEL_WEBHOOK_MAX_RETRIES=3
# How far back to look for undelivered events on startup (hours).
# Prevents replaying a large backlog after an extended outage:
SENTINEL_WEBHOOK_LOOKBACK_HOURS=24
# How often the webhook dispatch loop runs (seconds):
SENTINEL_WEBHOOK_DISPATCH_INTERVAL_SECONDS=60

# =============================================================================
# Backup — VM backups, exports and imports (starts with the stack; `docker compose stop backup proxy` to run without it)
# =============================================================================
# Bearer token the dashboard uses to talk to the Backup API. Empty = auth disabled.
BACKUP_API_TOKEN=CHANGE_ME
# Give up on a HyperCore export/import task after this many hours:
BACKUP_TASK_TIMEOUT_HOURS=8
# How often a running task is polled (seconds):
BACKUP_POLL_INTERVAL_SECONDS=15
# Defaults offered for new schedules:
BACKUP_DEFAULT_RETENTION=7
BACKUP_DEFAULT_RUN_TIME=03:00
# HyperCore removes a backup's reference snapshot itself after this many days (0 = never); a VM
# backed up less often than this gets a full with a note
BACKUP_ANCHOR_RETAIN_DAYS=60
# a run that finds the cluster updating itself or a node missing waits this long for it to clear,
# then is recorded as deferred and left to the next scheduled run
BACKUP_PREFLIGHT_WAIT_HOURS=2
# Bearer token between the backup service and the backup proxy container (and remote proxies):
PROXY_API_TOKEN=CHANGE_ME
# Parallel writers per backup job and /dev/nbd slots the proxy may use:
PROXY_WRITERS=4
PROXY_NBD_SLOTS=8
# How the proxy writes qcow2 images onto the target. The defaults skip the flush qemu would
# issue for every MiB written (twice the write rate onto an SMB share in our measurement); a
# finished point is still synced to the share before its checksum is taken, and an unfinished
# point is never valid. Set writeback/false to let qemu honour every flush. Settings → Backup
# proxies → "Measure throughput" compares the alternatives on your target; see the manual's installing chapter.
PROXY_QCOW2_LAZY_REFCOUNTS=true
PROXY_NBD_CACHE=unsafe
